{
  "name": "uu-english",
  "version": "1.0.1",
  "private": true,
  "description": "UU说英语 · 儿童英语学习静态 H5；无需 npm install 或打包依赖",
  "scripts": {
    "dev": "python3 scripts/serve.py",
    "build": "node scripts/build.cjs",
    "test": "node tests/verify-structure.cjs && node tests/verify-foundation-audio.cjs",
    "test:hub": "node tests/verify-hub.cjs",
    "test:storage": "node tests/verify-learning-journal.cjs && node tests/verify-profile-concurrency.cjs && node tests/verify-backup-size.cjs",
    "test:regression": "node tests/verify-review-fixes.cjs && node tests/verify-profile-scene-fixes.cjs && node tests/verify-recording-save.cjs && node tests/verify-review-concurrency.cjs && node tests/verify-favorite-offline-recovery.cjs",
    "test:phonics": "node tests/verify-phonics.cjs",
    "test:voices": "node tests/verify-voice-default.cjs && node tests/verify-voice-pack-import.cjs && node tests/verify-voice-packs.cjs && python3 -B tests/verify-child-voice-generation.py",
    "test:child-audio": "node tests/verify-child-audio-catalog.cjs && node tests/verify-installed-child-audio.cjs",
    "test:playback": "node tests/verify-playback-rate-change.cjs",
    "test:parents": "node tests/verify-parent-pages.cjs && node tests/verify-offline-management.cjs",
    "test:practice": "node tests/verify-sentence-resources.cjs && node tests/verify-practice-lab.cjs",
    "test:growth": "node tests/verify-growth.cjs",
    "test:progression": "node tests/verify-progression.cjs",
    "test:branches": "node tests/verify-scene-branches.cjs && node tests/verify-branch-recognition.cjs",
    "test:learning-links": "node tests/verify-functional-audit-fixes.cjs",
    "test:audio-layout": "node tests/verify-audio-layout.cjs",
    "test:build": "node tests/verify-build-security.cjs",
    "test:session": "node tests/verify-session-timing.cjs",
    "test:server": "python3 -B tests/verify-server-security.py",
    "test:server-browser": "node tests/verify-server-browser.cjs",
    "test:categories": "node tests/verify-category-rails.cjs",
    "test:layout": "node tests/verify-page-layout.cjs",
    "test:release": "node tests/verify-release.cjs",
    "test:release-browser": "node tests/verify-release-browser.cjs"
  }
}
